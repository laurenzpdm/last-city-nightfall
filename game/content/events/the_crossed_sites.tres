[resource]
resource_name = "Three Are Crossed Out"
script = ExtResource("3_2pqd8")
id = &"the_crossed_sites"
title = "Three Are Crossed Out"
category = &"scout"
lede = "The survey map has four other sites on it and three of them have a line through them."
body = "The crossings-out are in ink, in a hand that is not on the charter and is not on any of the sled manifests. They were made after the map was printed and before it reached this caldera.

Site Nine has no line through it. That is the entire reason there are {population} people here, and nobody has ever established who did the crossing out or what they were counting."
all_of = Array[ExtResource("1_kl2a2")]([SubResource("Resource_msjh8"), SubResource("Resource_vf743")])
