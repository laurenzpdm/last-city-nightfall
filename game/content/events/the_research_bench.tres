[resource]
resource_name = "Somebody Worked Something Out"
script = ExtResource("3_i285f")
id = &"the_research_bench"
title = "Somebody Worked Something Out"
priority = 52
lede = "The bench in the Survey Hall has produced its first finished thing."
body = "It is not an invention. Nobody in this caldera is inventing anything. It is somebody having the time to sit with a problem for long enough to notice what the column already knew and had written down badly.

{research_done} of those are now done. Every one of them changes something that is already standing, which is the only kind that matters at this temperature."
