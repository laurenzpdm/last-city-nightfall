[sub_resource type="Resource" id="Resource_8o2t6"]
script = ExtResource("2_ek1yi")
label = "Go out and speak to them"
body = "You go down the Ash Stair without the Watch and you stand in the cold with them for as long as it takes."
cost_line = "An hour of daylight, and every promise you make out there is one you have to keep. The Watch will not like being left inside."
gain_line = "They go back to their shifts having been answered by a person rather than by a notice on the door."
outcome = "You talked for an hour and you did not lie once, which took longer. They went back down the stair in ones and twos and the second boiler was running again by the evening whistle. Nothing was actually fixed. Everybody knows that too."
effects = Dictionary[StringName, float]({
&"approval:watch": -10.0,
&"approval:workers": 12.0,
&"discontent": -9.0,
&"hope": 3.0,
&"stock:coal": -20.0
})

[sub_resource type="Resource" id="Resource_pfo03"]
script = ExtResource("2_ek1yi")
label = "Send the Watch to move them on"
body = "Four men with the bar off the North Gate. It takes about six minutes and nobody is hurt."
cost_line = "They will remember it, and so will everyone who watched from Kettle Row. The Hearthside will not send their children up here again."
gain_line = "The doorway is clear, the shift is back on time, and you have not conceded a single thing."
outcome = "They were gone in six minutes and the Watch did it without raising a hand, which the Watch will tell you about. The woman from the second boiler was the last to leave. She looked at the door for a while before she went."
effects = Dictionary[StringName, float]({
&"approval:families": -8.0,
&"approval:watch": 10.0,
&"approval:workers": -18.0,
&"discontent": 6.0,
&"hope": -5.0
})
tags = Array[StringName]([&"cruel"])
is_default = true

[resource]
resource_name = "A Delegation at the Hall"
script = ExtResource("3_j3rhe")
id = &"the_delegation"
title = "A Delegation at the Hall"
category = &"dilemma"
priority = 80
lede = "Forty of them came up the Ash Stair and stopped at the door."
body = "They are not carrying anything. That is the first thing you notice, and it is deliberate: somebody thought about how this would look.

The woman at the front does the talking. She works the second boiler and she has the burn on her forearm that everybody on that shift has. She says the Nine has stopped being a place where things get decided and started being a place where things get announced. She says she is not asking you to change any of it. She is asking you to come out and say it to them yourself.

Discontent stands at {discontent}. Behind her, {population} people are waiting to hear what kind of answer this is."
cause_prose = "Nobody organised this. It accumulated."
all_of = Array[ExtResource("1_d5x3f")]([SubResource("Resource_te00k"), SubResource("Resource_n2lli")])
once = false
cooldown_hours = 72.0
options = Array[ExtResource("2_ek1yi")]([SubResource("Resource_8o2t6"), SubResource("Resource_pfo03")])
deadline_hours = 6.0
tags = Array[StringName]([&"society"])
