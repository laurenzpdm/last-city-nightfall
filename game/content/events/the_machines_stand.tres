[resource]
resource_name = "The Floor Is Quiet"
script = ExtResource("3_ta70f")
id = &"the_machines_stand"
title = "The Floor Is Quiet"
priority = 58
lede = "{stalled_machines} machines are stopped and the crews are standing next to them."
body = "A stopped machine in {city} is not a machine waiting for a part. It is a machine waiting for a decision that was supposed to have been taken upstream of it: heat that is somewhere else, an input that nobody routed, or a crew that is on the wall instead.

The crews are still being fed. That is the arithmetic that makes an idle machine expensive."
all_of = Array[ExtResource("1_c40ut")]([SubResource("Resource_x5ida")])
once = false
cooldown_hours = 48.0
