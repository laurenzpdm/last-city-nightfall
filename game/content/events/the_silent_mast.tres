[resource]
resource_name = "The Mast on the Northern Rise"
script = ExtResource("3_qaaj2")
id = &"the_silent_mast"
title = "The Mast on the Northern Rise"
category = &"scout"
priority = 54
lede = "There is a wireless mast eleven hours north, iced to the guys, and it has power."
body = "The scouts could hear the transformer humming from the bottom of the rise. The hut at the base is locked from the inside and the window is frosted over from the inside as well.

Whatever it is transmitting, it is not transmitting to {city}. The column had a receiver on the second sled and it has been silent since the day the column stopped here, and somebody checks it every week anyway."
all_of = Array[ExtResource("1_spptk")]([SubResource("Resource_pmjf7")])
