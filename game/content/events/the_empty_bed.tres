[resource]
resource_name = "There Is a Bed Free"
script = ExtResource("3_bk3gi")
id = &"the_empty_bed"
title = "There Is a Bed Free"
priority = 45
lede = "The care house has an empty bed in it for the first time since it opened."
body = "Nobody put a notice up. It was noticed by the third person to walk past the door and it was all over Kettle Row by the evening whistle.

Hope stands at {hope}, which is not a number anybody in the Nine has ever been told, and which they can nonetheless read off the fact that the physician was sitting down at four in the afternoon."
