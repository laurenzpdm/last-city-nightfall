[resource]
resource_name = "Drift Hound"
script = ExtResource("1_dhnd")
id = &"drift_hound"
display_name = "Drift Hound"
description = "Comes in sixes and dies to a stiff breeze — but not to one breath of it. Forty-two points: two rounds off the burner cannon at every damage rung the first week can reach, and a wall that answers a pack of six one round at a time is still reloading when the seventh arrives. That is the whole lesson. Single-target damage is the wrong answer; a cone or a scatter is the right one."
