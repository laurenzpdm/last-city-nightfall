title = "Heat Recovery"
description = "THE BEAT: mid campaign, once the base is wide enough that transmission loss is a line item rather than a rounding error. This is the node that rewards a player who has actually read the flow overlay, and it stacks with lagging instead of replacing it — the two together take a thirty-five percent loss down to something survivable."
flavour = "The exhaust goes back into the intake. The stack stops steaming."
tier = 3
