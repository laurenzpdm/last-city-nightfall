[resource]
resource_name = "The Last Furnace"
script = ExtResource("1_yxwr7")
id = &"the_last_furnace"
title = "The Last Furnace"
description = "THE BEAT: the end of the dark branch, reachable only by a player who took every step of it. Everything that is not the hearth becomes fuel: outbuildings, stores, whole districts. It ends the campaign one way or the other, and it exists so that 'we survived' is not automatically the same sentence as 'we were right'."
flavour = "The hearth burns hotter than it ever has. There is nothing left around it to warm."
