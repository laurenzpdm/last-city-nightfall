id = &"night_shift_rotation"
title = "Night Shift Rotation"
description = "THE BEAT: around day three, when the player first tries to finish a wall before dusk and cannot. It is the honest version of the desperate branch's answer to the same problem: you can pay for the hours with organisation now, or pay for them with people later."
flavour = "Two shifts, staggered, and the second one fed first. Nobody likes it. Everybody sleeps."
branch = &"survival"
tier = 2
