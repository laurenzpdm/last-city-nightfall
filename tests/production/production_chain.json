    {"tick": 60, "cmd": {"system": "production", "op": "ratios"}},
    {"tick": 2000, "cmd": {"system": "production", "op": "dump"}},
    {"tick": 4500, "cmd": {"system": "production", "op": "dump"}},
    {"tick": 4600, "cmd": {"system": "production", "op": "set_recipe", "cell": [137, 125], "recipe": "circuit"}},
    {"tick": 7000, "cmd": {"system": "production", "op": "set_recipe", "cell": [137, 125], "recipe": "insulation"}},
    {"tick": 8990, "cmd": {"system": "production", "op": "dump"}},
    {"tick": 8995, "cmd": {"system": "heat", "op": "dump"}}
