    {"tick": 25, "cmd": {"system": "build", "op": "place", "kind": "heat_pipe", "cell": [165, 132], "free": true, "instant": true}},
    {"tick": 26, "cmd": {"system": "build", "op": "place", "kind": "ore_drill", "cell": [162, 131], "free": true, "instant": true}},
    {"tick": 27, "cmd": {"system": "build", "op": "place", "kind": "warmth_radiator", "cell": [165, 133], "free": true, "instant": true}},

    {"tick": 30, "cmd": {"system": "build", "op": "place", "kind": "coal_generator", "cell": [128, 98], "free": true, "instant": true}},
    {"tick": 31, "cmd": {"system": "build", "op": "place", "kind": "heat_pipe", "cell": [127, 99], "free": true, "instant": true}},
    {"tick": 32, "cmd": {"system": "build", "op": "place", "kind": "ore_drill", "cell": [124, 98], "free": true, "instant": true}},
