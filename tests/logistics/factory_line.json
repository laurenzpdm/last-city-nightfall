{
  "name": "factory_line",
  "description": "A running factory, so [P03] can be judged from a run instead of a summary. A crate of four hundred coal, an arm that loads a belt, a sunken belt that crosses somebody else's line, a splitter that halves the flow, and a second arm that shovels coal into a generator's bunker. The city's own coal is set to zero on tick one, so the only coal in the world is the coal on that belt, so heat.supply is nonzero if and only if the factory is working. Run it with: godot --headless --path . -- --harness --scenario=res://tests/logistics/factory_line.json --ticks=4000 --out=artifacts/factory. It lives here rather than in tests/scenarios/ because that folder is generated by tools/gen_scenarios.py and belongs to [P00].",
  "tags": ["reference", "logistics"],
  "seed": 7,
  "ticks": 4000,
  "sample_every": 20,
  "expects": {
    "max_errors": 0
  },
  "script": [
    {"tick": 1, "cmd": {"system": "build", "op": "add_stock", "items": {
      "iron_plate": 300, "gear": 200, "timber": 200,
      "scrap": 300, "steel_plate": 200, "stone": 300, "circuit": 60}}},

    {"tick": 1, "cmd": {"system": "build", "op": "grant_unlock", "unlock": "belt_gearing"}},
    {"tick": 1, "cmd": {"system": "build", "op": "set_stock", "items": {"coal": 0}}},

    {"tick": 2, "cmd": {"system": "build", "op": "place", "kind": "coal_generator",
      "cell": [55, 43], "free": true, "instant": true}},

    {"tick": 2, "cmd": {"system": "build", "op": "place", "kind": "warmth_radiator",
      "cell": [58, 43], "free": true, "instant": true}},

    {"tick": 3, "cmd": {"system": "logistics", "op": "place", "kind": "crate", "cell": [40, 40]}},
    {"tick": 4, "cmd": {"system": "logistics", "op": "insert", "cell": [40, 40],
      "item": "coal", "count": 400}},
    {"tick": 5, "cmd": {"system": "logistics", "op": "place", "kind": "inserter_mk2",
      "cell": [41, 40], "rot": 0}},

    {"tick": 6, "cmd": {"system": "logistics", "op": "place_line", "kind": "belt_mk1",
      "from": [42, 40], "to": [43, 40]}},
    {"tick": 7, "cmd": {"system": "logistics", "op": "place", "kind": "underground_mk1",
      "cell": [44, 40], "rot": 0}},
    {"tick": 8, "cmd": {"system": "logistics", "op": "place", "kind": "underground_mk1",
      "cell": [47, 40], "rot": 0}},

    {"tick": 9, "cmd": {"system": "logistics", "op": "place_line", "kind": "belt_mk1",
      "from": [45, 37], "to": [45, 42]}},
    {"tick": 10, "cmd": {"system": "logistics", "op": "place", "kind": "crate", "cell": [45, 43]}},

    {"tick": 11, "cmd": {"system": "logistics", "op": "place", "kind": "belt_mk1",
      "cell": [48, 40], "rot": 0}},
    {"tick": 12, "cmd": {"system": "logistics", "op": "place", "kind": "splitter_mk1",
      "cell": [49, 39], "rot": 0}},
    {"tick": 13, "cmd": {"system": "logistics", "op": "place_line", "kind": "belt_mk1",
      "from": [50, 39], "to": [52, 39]}},
    {"tick": 14, "cmd": {"system": "logistics", "op": "place", "kind": "crate", "cell": [53, 39]}},
    {"tick": 15, "cmd": {"system": "logistics", "op": "place_line", "kind": "belt_mk1",
      "from": [50, 40], "to": [53, 43]}},
    {"tick": 16, "cmd": {"system": "logistics", "op": "place", "kind": "inserter_mk1",
      "cell": [54, 43], "rot": 0}},

    {"tick": 30, "cmd": {"system": "logistics", "op": "insert", "cell": [45, 37],
      "item": "iron_ore", "count": 8}},
    {"tick": 40, "cmd": {"system": "logistics", "op": "insert", "cell": [45, 37],
      "item": "iron_ore", "count": 8}},
    {"tick": 50, "cmd": {"system": "logistics", "op": "insert", "cell": [45, 37],
      "item": "iron_ore", "count": 8}},


    {"tick": 1200, "cmd": {"system": "logistics", "op": "dump"}},
    {"tick": 2000, "cmd": {"system": "logistics", "op": "set_priority",
      "cell": [49, 39], "output": "right"}},
    {"tick": 2400, "cmd": {"system": "logistics", "op": "dump"}},
    {"tick": 3000, "cmd": {"system": "heat", "op": "dump"}},
    {"tick": 3900, "cmd": {"system": "logistics", "op": "dump"}}
  ]
}
